<Window x:Class="MobiStore.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="موبي ستور — إدارة المحل" Icon="{StaticResource BrandMark}" Width="1440" Height="920" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen" FlowDirection="LeftToRight">
 <Grid>
  <Grid x:Name="Shell" Visibility="Collapsed" Background="#EFF3F8">
   <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Border Background="#11233E" Padding="28,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#1D3B4A" CornerRadius="8" Padding="12,7"><TextBlock Text="مساحة العمل" Foreground="#65DCC1" FontSize="11"/></Border><TextBlock x:Name="IdentityText" Text="تسجيل الدخول" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="#C2D0DF" FlowDirection="RightToLeft"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><StackPanel Margin="0,0,15,0" VerticalAlignment="Center"><TextBlock Text="موبي ستور" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock x:Name="ShopText" Text="المبيعات · المخزون · الحسابات" Foreground="#8BA5BC" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel><Image Source="{StaticResource BrandMark}" Width="48" Height="48"/></StackPanel>
   </Grid></Border>
   <Border Grid.Row="1" Background="White" BorderBrush="#DFE6EF" BorderThickness="0,0,0,1"><Menu x:Name="SectionMenu" Background="Transparent" FlowDirection="RightToLeft" VerticalAlignment="Center" Margin="20,0" FontSize="13"/></Border>
   <Border Grid.Row="2" Background="White" Padding="20,10" BorderBrush="#DFE6EF" BorderThickness="0,0,0,1"><WrapPanel x:Name="Nav" FlowDirection="RightToLeft"/></Border>
   <Grid Grid.Row="3" Margin="22,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="222"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,18,0"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="BreadcrumbText" Text="الرئيسية" FlowDirection="RightToLeft" HorizontalAlignment="Right" Foreground="#6A7D95" FontSize="12"/><Border Grid.Row="1" CornerRadius="16" Background="White" BorderBrush="#E1E8F0" BorderThickness="1"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="27,24" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Body" FlowDirection="RightToLeft"/></ScrollViewer></Border></Grid>
    <StackPanel Grid.Column="1" FlowDirection="RightToLeft" Margin="0,34,0,0">
     <Border Background="#11233E" CornerRadius="16" Padding="21,25"><StackPanel><TextBlock Text="يوم عمل موفق" Foreground="#64DDC0" FontSize="12"/><TextBlock Text="كل التفاصيل،&#x0a;بين يديك." Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,14,0,19" LineHeight="38"/><TextBlock x:Name="BusinessDate" Foreground="#A0B5C9" TextWrapping="Wrap" FontSize="12" LineHeight="23"/></StackPanel></Border>
     <Border Background="White" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="مساحة مترابطة" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="المبيعات والمخزون والحسابات والموظفون، في تجربة واحدة." Foreground="#8594A9" TextWrapping="Wrap" LineHeight="24" Margin="0,12,0,15"/><Border Background="#EAF8F3" CornerRadius="8" Padding="10"><TextBlock Text="MOBI STORE" Foreground="#078B78" FontSize="11"/></Border></StackPanel></Border>
    </StackPanel>
   </Grid>
   <Border Grid.Row="4" Background="White" BorderBrush="#DFE6EF" BorderThickness="0,1,0,0" Padding="20,7"><TextBlock x:Name="StatusText" Text="جاهز" TextTrimming="CharacterEllipsis" Foreground="#74869E" FontSize="11" FlowDirection="RightToLeft"/></Border>
  </Grid>
  <Grid x:Name="AuthSurface" Background="#11233E">
   <Ellipse Width="650" Height="650" Stroke="#223F56" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-300,0,0,-300"/>
   <Grid Margin="60,40" MaxWidth="1160"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="White" CornerRadius="24" Padding="42,34" Margin="0,0,45,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel FlowDirection="RightToLeft" VerticalAlignment="Center">
     <Border Background="#EAF8F2" CornerRadius="8" Padding="12,7" HorizontalAlignment="Right"><TextBlock Text="مرحبًا بك في مساحة عملك" Foreground="#078B78" FontSize="12"/></Border>
     <TextBlock x:Name="AuthTitle" Text="أهلًا بعودتك" FontSize="32" FontWeight="Bold" Margin="0,22,0,9"/><TextBlock x:Name="AuthSubtitle" Foreground="#7F90A6" TextWrapping="Wrap" LineHeight="25" Margin="0,0,0,25"/>
     <StackPanel x:Name="AuthForm"/>
     <Border Background="#F5F8FB" CornerRadius="10" Padding="15" Margin="0,18,0,0"><TextBlock x:Name="AuthNotice" Foreground="#71869C" FontSize="12" TextWrapping="Wrap" LineHeight="23"/></Border>
    </StackPanel></ScrollViewer></Border>
    <Grid Grid.Column="1" FlowDirection="RightToLeft" Margin="10,20,0,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><Image Source="{StaticResource BrandMark}" Width="76" Height="76" HorizontalAlignment="Left"/><TextBlock Text="موبي ستور" Foreground="White" FontSize="33" FontWeight="Bold" Margin="0,20,0,4"/><TextBlock Text="MOBI STORE" Foreground="#7DA5B8" FontSize="12"/></StackPanel>
     <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="تجارتك أوضح.&#x0a;وقتك لأعمالك." Foreground="White" FontSize="39" FontWeight="SemiBold" LineHeight="61"/><TextBlock Text="من أول فاتورة إلى إغلاق الصندوق،&#x0a;كل ما تحتاجه لإدارة محلك." Foreground="#9DB5C9" FontSize="15" LineHeight="29" Margin="0,22,0,30"/><Border Background="#1B354C" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="مبيعات  ·  مخزون  ·  حسابات" Foreground="#68DEC3" FontWeight="SemiBold"/><TextBlock Text="فريقك وبياناتك، في تجربة واحدة" Foreground="#92ACBF" FontSize="12" Margin="0,9,0,0"/></StackPanel></Border></StackPanel>
     <TextBlock Grid.Row="2" Text="صُمّم لتفاصيل تجارتك" Foreground="#6D90A9" FontSize="12"/>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
