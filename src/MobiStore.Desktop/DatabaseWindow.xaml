<Window x:Class="MobiStore.Desktop.DatabaseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="موبي ستور — إدارة قواعد البيانات" Icon="{StaticResource BrandMark}" Width="1040" Height="740" MinWidth="900" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#F4F7FB">
 <Window.Resources>
  <Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="White" BorderBrush="#E0E7EF" BorderThickness="1" CornerRadius="12" Padding="18"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#EDF9F5"/><Setter TargetName="Card" Property="BorderBrush" Value="#0AA58C"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#0AA58C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid x:Name="panel"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
  <Grid Margin="36,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel FlowDirection="RightToLeft"><TextBlock Text="إدارة قواعد البيانات" Foreground="#7990A6" FontSize="12"/><TextBlock Text="أعمالك تبدأ من هنا" FontSize="30" FontWeight="Bold" Margin="0,9,0,7"/><TextBlock Text="اختر قاعدة بيانات للمتابعة إلى حسابك." Foreground="#718198" FontSize="14"/></StackPanel>
   <Border Grid.Row="1" Background="White" BorderBrush="#E3EAF2" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,23,0,22"><Expander FlowDirection="RightToLeft"><Expander.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE968;" Foreground="#078B78" Margin="0,0,10,0"/><TextBlock x:Name="connectionText" Text="الاتصال بخادم موبي ستور" FontWeight="SemiBold"/></StackPanel></Expander.Header><StackPanel Margin="0,12,0,0"><TextBlock Text="عنوان الخدمة" Foreground="#718198" FontSize="12"/><TextBox x:Name="address" FlowDirection="LeftToRight"/><Button x:Name="refreshButton" Content="تحديث الاتصال والقواعد" Style="{StaticResource SecondaryButton}"/></StackPanel></Expander></Border>
   <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,14"><TextBlock x:Name="countText" Text="قواعد البيانات" Foreground="#8492A6" VerticalAlignment="Center"/><TextBlock Text="مساحات العمل" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold"/></Grid>
    <ListBox x:Name="databases" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"><ListBox.ItemTemplate><DataTemplate><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" Foreground="#078B78" VerticalAlignment="Center"/><StackPanel Grid.Column="1" FlowDirection="RightToLeft" Margin="10,0,14,0"><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Name}" FontSize="11" Foreground="#7A8CA3" Margin="0,7,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Right"/></StackPanel><Border Grid.Column="2" Background="#E6F4EF" CornerRadius="12" Width="48" Height="48"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Foreground="#078B78" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBlock Grid.Row="2" x:Name="details" Text="جارٍ تحميل القواعد…" TextWrapping="Wrap" FontSize="11" Foreground="#718198" Margin="0,8,0,12"/>
   </Grid>
   <StackPanel Grid.Row="3"><CheckBox x:Name="automatic" Content="فتح آخر قاعدة تلقائيًا في المرة القادمة" FlowDirection="RightToLeft" Margin="0,10,0,15"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="cancelButton" Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/><Button Grid.Column="1" x:Name="openButton" Content="الدخول إلى مساحة العمل   ←" HorizontalContentAlignment="Center" Margin="0" IsDefault="True"/></Grid></StackPanel>
  </Grid>
  <Border Grid.Column="1" Background="#11233E"><Grid Margin="27,34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel FlowDirection="RightToLeft"><Image Source="{StaticResource BrandMark}" Width="64" Height="64" HorizontalAlignment="Right"/><TextBlock Text="موبي ستور" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,18,0,3"/><TextBlock Text="MOBI STORE" Foreground="#6F9AA8" FontSize="11"/></StackPanel>
   <StackPanel Grid.Row="1" VerticalAlignment="Center" FlowDirection="RightToLeft"><TextBlock Text="مساحة واحدة.&#x0a;رؤية أوضح." FontSize="31" Foreground="White" FontWeight="SemiBold" LineHeight="48"/><TextBlock Text="نظّم بيانات محلك وتابع فريقك&#x0a;ومبيعاتك من مكان واحد." Foreground="#92ACBD" LineHeight="25" Margin="0,17,0,28"/><Button x:Name="newButton" Content="＋   إنشاء قاعدة جديدة" HorizontalContentAlignment="Center" Margin="0,0,0,12"/><Button x:Name="registerButton" Content="إضافة قاعدة موجودة" Background="#203951" Foreground="#DAE6EE" HorizontalContentAlignment="Center" Margin="0"/></StackPanel>
   <TextBlock Grid.Row="2" Text="إدارة المبيعات والمخزون والحسابات" Foreground="#6F8DA4" FlowDirection="RightToLeft" FontSize="11"/>
  </Grid></Border>
 </Grid>
</Window>
